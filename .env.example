# Base de desarrollo. En Railway se expone como variable de referencia
# (${{ Postgres.DATABASE_URL }}), que se resincroniza sola si cambian las credenciales (§7.2).
DATABASE_URL="postgresql://usuario:password@host:5432/railway"

# Base de tests de integración. TIENE que ser una base distinta de la de desarrollo:
# la suite trunca todas las tablas antes de cada test.
DATABASE_URL_TEST="postgresql://usuario:password@host:5432/railway_test"
