# ---------------------------------------------------------------------------
# Desarrollo local con `prisma dev`.
#
#   npx prisma dev -d -n verduleria-dev
#   npx prisma dev -d -n verduleria-test
#
# Cada comando imprime el puerto que le asignó. Ajustá los de abajo según lo que
# haya salido: `npx prisma dev ls` los vuelve a mostrar.
#
# Dev y test son dos SERVIDORES distintos, no dos bases del mismo: un servidor de
# `prisma dev` sirve una sola base y el nombre en la URL es decorativo. Si
# compartieran servidor, la suite de tests —que trunca todas las tablas antes de
# cada test— borraría los datos de desarrollo.
# ---------------------------------------------------------------------------

DATABASE_URL="postgres://postgres:postgres@localhost:51214/verduleria_dev?sslmode=disable"

# OBLIGATORIO, no opcional. Prisma necesita una base descartable para calcular el
# diff de cada migración. Si no se le indica cuál, la crea en el mismo servidor que
# DATABASE_URL —que es la misma base— y APLICA LA MIGRACIÓN SOBRE LA BASE REAL
# creyendo que es descartable. Cada servidor de `prisma dev` levanta un store
# shadow vacío en el puerto siguiente al de la base.
# `localhost` NO sirve acá: en Windows resuelve primero a ::1 y el store shadow
# de `prisma dev` escucha solo en IPv4, así que `migrate dev` falla con P1001.
SHADOW_DATABASE_URL="postgres://postgres:postgres@127.0.0.1:51215/shadow?sslmode=disable"

# Base de tests de integración. La suite trunca todas las tablas antes de cada test.
DATABASE_URL_TEST="postgres://postgres:postgres@localhost:51218/verduleria_test?sslmode=disable"
SHADOW_DATABASE_URL_TEST="postgres://postgres:postgres@127.0.0.1:51219/shadow?sslmode=disable"

# ---------------------------------------------------------------------------
# Railway (cuando se despliegue).
#
# DATABASE_URL se carga como variable de referencia al Postgres del entorno:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
# Así se resincroniza sola si cambian las credenciales (§7.2).
#
# SHADOW_DATABASE_URL no hace falta en Railway: el pre-deploy corre
# `prisma migrate deploy`, que aplica migraciones ya calculadas y no necesita
# shadow database. Solo `migrate dev`, que es local, la usa.
# ---------------------------------------------------------------------------
