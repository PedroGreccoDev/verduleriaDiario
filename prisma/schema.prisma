// Estación Verde — Módulo Diario
// Modelo de datos según §3 de especificacion-modulo-diario.md
//
// Reglas que atraviesan todo el schema:
//   - Todo monto es Decimal @db.Decimal(14,0) → NUMERIC en Postgres. Nunca Float (§7.1).
//     Escala CERO: la moneda es el peso argentino y no se usan centavos (AGENTS.md).
//     La escala la impone la base, así que un centavo no entra ni por error de código.
//     El único campo con decimales es porcentaje_descuento, que no es un monto.
//   - Bolsa Grande (efectivo) y cartera de cheques (nominal) son saldos separados (§2.1).
//     La cartera no tiene tabla propia: es el conjunto de cheques con estado = en_cartera.
//   - El ahorro por cheques no vive en movimiento_caja. Se deriva de los cheques
//     entregados, agrupados por fecha_entrega (§2.3).
//
// §3 define usuario_id en turno, movimiento_caja y movimiento_cuenta_corriente.
// SÍ se implementa, desde §9. La decisión anterior —un único usuario compartido
// entre los dos socios, login solo para que no entre cualquiera— se dio vuelta
// cuando el local pasó a trabajar con empleados: ahora importa quién cargó qué.
//
// La columna es NULLABLE y se queda así. Todo lo cargado antes de que existieran
// los usuarios no tiene autor y no se le inventa uno: `null` se muestra como
// "antes de los usuarios". Backfillear con el primer administrador dejaría las
// pantallas más prolijas a cambio de atribuirle a una persona movimientos que no
// hizo, que es exactamente el tipo de dato que este campo existe para evitar.
//
// La FK es onDelete: SetNull, no Restrict. Borrar un usuario es una operación
// real del sistema (§9) y deja sus movimientos sin autor, con el mismo `null` que
// lo anterior a los usuarios. Es una pérdida de información asumida: el borrado
// existe para que una cuenta pueda desaparecer de verdad, y guardar el nombre
// igual sería no borrarla. Para conservar la autoría está la baja.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// §3.1 Caja / Bolsa Grande
// ---------------------------------------------------------------------------

enum EstadoTurno {
  abierto
  cerrado
}

enum TipoMovimientoCaja {
  ingreso
  egreso
}

/// Origen del movimiento. referencia_id apunta al registro que lo generó,
/// sin FK: es polimórfica a propósito (§3.1).
enum ReferenciaMovimientoCaja {
  retiro_turno
  compra_cheque
  pago_proveedor
  cobro_cliente
  gasto
  retiro_socio
  manual
}

model Turno {
  id     String      @id @default(cuid())
  fecha  DateTime    @db.Date
  /// 'mañana' | 'tarde'. String y no enum a propósito: §8.4 (¿siempre son dos
  /// turnos por día?) está sin resolver, y un enum obligaría a migrar para agregar uno.
  nombre String
  estado EstadoTurno @default(abierto)

  fechaApertura DateTime  @default(now()) @map("fecha_apertura")
  fechaCierre   DateTime? @map("fecha_cierre")

  observacion String?

  /// Quién lo abrió. Null = turno anterior a los usuarios (ver cabecera).
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  movimientos MovimientoCaja[]

  @@index([fecha])
  @@index([estado])
  @@map("turno")
}

/// Tabla y no enum por decisión de §3.1: van a querer agregar categorías sin tocar el código.
model CategoriaMovimiento {
  id     String             @id @default(cuid())
  nombre String             @unique
  tipo   TipoMovimientoCaja
  /// Discrimina las categorías que crea el sistema (retiro de turno, compra de
  /// cheques, pago a proveedor) de las que puede agregar el operador.
  /// Las del sistema no deberían borrarse ni renombrarse.
  slug   String             @unique
  activo Boolean            @default(true)
  orden  Int                @default(0)

  movimientos MovimientoCaja[]

  @@map("categoria_movimiento")
}

/// Movimiento de la Bolsa Grande. Es la única tabla que alimenta el reporte de §5.1.
/// Comprar un cheque genera uno (egreso); entregarlo NO genera ninguno (§2.3, §4.3).
model MovimientoCaja {
  id    String   @id @default(cuid())
  fecha DateTime @default(now())

  /// Nullable: puede haber movimientos fuera de turno (§3.1).
  turnoId String? @map("turno_id")
  turno   Turno?  @relation(fields: [turnoId], references: [id], onDelete: Restrict)

  tipo        TipoMovimientoCaja
  categoriaId String              @map("categoria_id")
  categoria   CategoriaMovimiento @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  /// Siempre positivo. El signo lo da `tipo` (§3.1).
  /// Hay un CHECK (monto > 0) en la migración.
  monto Decimal @db.Decimal(14, 0)

  referenciaTipo ReferenciaMovimientoCaja @map("referencia_tipo")
  /// FK polimórfica, sin constraint de integridad referencial.
  referenciaId   String?                  @map("referencia_id")

  observacion String?

  /// Quién lo cargó. Null = movimiento anterior a los usuarios (ver cabecera).
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha, tipo])
  @@index([turnoId])
  @@index([categoriaId])
  @@index([referenciaTipo, referenciaId])
  @@index([usuarioId])
  @@map("movimiento_caja")
}

// ---------------------------------------------------------------------------
// §3.2 Cheques
// ---------------------------------------------------------------------------

/// §8.2 resuelto: NO existe `acreditado`. La verdulería no hace seguimiento de si
/// el proveedor cobró el cheque; para ellos termina en `entregado`. Lo único que
/// puede pasar después es que rebote, y para eso está `rechazado`.
enum EstadoCheque {
  en_cartera
  entregado
  rechazado
}

model VendedorCheque {
  id       String  @id @default(cuid())
  nombre   String
  contacto String?
  activo   Boolean @default(true)

  cheques Cheque[]

  @@map("vendedor_cheque")
}

/// Un cheque de terceros. Mientras está `en_cartera` forma parte del saldo de
/// cartera, medido a valor nominal (§2.1).
model Cheque {
  id       String @id @default(cuid())
  numero   String
  banco    String
  librador String

  /// Valor de cara del cheque. Es lo que entra a la cartera y lo que cancela deuda.
  nominal             Decimal @db.Decimal(14, 0)
  /// Lo que tipea el operador, en puntos porcentuales (12.5 = 12,5 %).
  porcentajeDescuento Decimal @map("porcentaje_descuento") @db.Decimal(5, 2)
  /// Calculado: nominal × (1 − porcentaje/100), redondeado HACIA ABAJO al peso.
  /// El resto queda a favor de la verdulería, que paga de menos (AGENTS.md).
  /// Es el efectivo que sale de la Bolsa Grande al comprarlo.
  montoPagado         Decimal @map("monto_pagado") @db.Decimal(14, 0)
  /// Calculado: nominal − monto_pagado. Se guarda (y no se recalcula) para que los
  /// históricos no cambien si cambia la política de redondeo (§3.2).
  /// Latente hasta la entrega: acá no significa que el ahorro esté realizado (§2.3).
  ahorro              Decimal @db.Decimal(14, 0)

  fechaCompra      DateTime @default(now()) @map("fecha_compra")
  /// §8.1 resuelto: los cheques nunca llegan al vencimiento en cartera, así que no
  /// hay alerta ni estado de vencido. La fecha se guarda porque ordena la cartera.
  fechaVencimiento DateTime @map("fecha_vencimiento") @db.Date

  vendedorChequeId String         @map("vendedor_cheque_id")
  vendedorCheque   VendedorCheque @relation(fields: [vendedorChequeId], references: [id], onDelete: Restrict)

  estado EstadoCheque @default(en_cartera)

  /// Fecha a la que se imputa el ahorro realizado (§6). Null hasta la entrega.
  fechaEntrega       DateTime?  @map("fecha_entrega")
  proveedorDestinoId String?    @map("proveedor_destino_id")
  proveedorDestino   Proveedor? @relation(fields: [proveedorDestinoId], references: [id], onDelete: Restrict)

  /// §4.4 pide registrar fecha y motivo del rechazo. §3.2 no los lista; se agregan
  /// porque sin ellos el historial de rechazos por librador y por vendedor (§5.2)
  /// no se puede armar.
  fechaRechazo  DateTime? @map("fecha_rechazo")
  motivoRechazo String?   @map("motivo_rechazo")

  observacion String?

  imputaciones ImputacionCheque[]
  pagos        PagoProveedor[]

  @@unique([banco, numero, librador])
  @@index([estado, fechaVencimiento])
  @@index([fechaEntrega])
  @@index([librador])
  @@index([vendedorChequeId])
  @@map("cheque")
}

/// Resuelve que un cheque cubra varias facturas (§3.2). Deliberadamente NO hay
/// un factura_id en `cheque`.
/// Invariante: Σ monto_imputado de un cheque ≤ cheque.nominal (§4.3).
model ImputacionCheque {
  id String @id @default(cuid())

  chequeId String @map("cheque_id")
  cheque   Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  facturaProveedorId String           @map("factura_proveedor_id")
  factura            FacturaProveedor @relation(fields: [facturaProveedorId], references: [id], onDelete: Restrict)

  montoImputado Decimal @map("monto_imputado") @db.Decimal(14, 0)

  @@unique([chequeId, facturaProveedorId])
  @@index([facturaProveedorId])
  @@map("imputacion_cheque")
}

// ---------------------------------------------------------------------------
// §3.3 Proveedores
// ---------------------------------------------------------------------------

enum EstadoFactura {
  pendiente
  parcial
  pagada
}

enum MedioPago {
  efectivo
  cheque
  transferencia
}

model Proveedor {
  id       String  @id @default(cuid())
  nombre   String
  contacto String?

  /// Positivo = se le debe. NEGATIVO = saldo a favor, por diseño (§3.3).
  /// El excedente de un cheque cuyo nominal supera la deuda imputada cae acá y se
  /// descuenta de la próxima factura. No hay rama especial para ese caso.
  saldo Decimal @default(0) @db.Decimal(14, 0)

  activo Boolean @default(true)

  facturas         FacturaProveedor[]
  pagos            PagoProveedor[]
  chequesRecibidos Cheque[]

  @@index([activo])
  @@map("proveedor")
}

model FacturaProveedor {
  id String @id @default(cuid())

  proveedorId String    @map("proveedor_id")
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  numero           String
  fecha            DateTime  @db.Date
  fechaVencimiento DateTime? @map("fecha_vencimiento") @db.Date

  montoTotal     Decimal       @map("monto_total") @db.Decimal(14, 0)
  /// Nunca negativo: el excedente de un pago no se acumula acá sino en proveedor.saldo.
  /// Hay un CHECK (saldo_pendiente >= 0) en la migración.
  saldoPendiente Decimal       @map("saldo_pendiente") @db.Decimal(14, 0)
  estado         EstadoFactura @default(pendiente)

  imputacionesCheque ImputacionCheque[]
  imputacionesPago   ImputacionPago[]

  @@unique([proveedorId, numero])
  @@index([proveedorId, estado])
  @@index([fechaVencimiento])
  @@map("factura_proveedor")
}

/// Pago a proveedor. Se genera en dos flujos distintos:
///   - §4.5 efectivo/transferencia → además genera un movimiento_caja de egreso.
///   - §4.3 entrega de cheque      → medio = cheque, monto = nominal, SIN movimiento_caja.
/// Cuidado en reportes: sumar esta tabla mezcla efectivo con nominal de cheques.
/// Para flujo de caja hay que ir a movimiento_caja (§5.1).
model PagoProveedor {
  id String @id @default(cuid())

  proveedorId String    @map("proveedor_id")
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  fecha DateTime  @default(now())
  medio MedioPago
  monto Decimal   @db.Decimal(14, 0)

  /// Solo cuando medio = cheque. Hay un CHECK en la migración que lo exige
  /// y que lo prohíbe para los otros medios.
  chequeId String? @map("cheque_id")
  cheque   Cheque? @relation(fields: [chequeId], references: [id], onDelete: Restrict)

  observacion String?

  /// Vacío para medio = cheque: las imputaciones de un cheque viven en
  /// imputacion_cheque, colgadas del cheque (§3.2).
  imputaciones ImputacionPago[]

  @@index([proveedorId, fecha])
  @@index([chequeId])
  @@map("pago_proveedor")
}

/// Espejo de imputacion_cheque para los pagos en efectivo/transferencia.
/// §4.5 dice "mismo flujo de imputación a facturas" pero §3.3 no define la tabla;
/// se agrega para que un pago en efectivo pueda cubrir varias facturas.
model ImputacionPago {
  id String @id @default(cuid())

  pagoProveedorId String        @map("pago_proveedor_id")
  pago            PagoProveedor @relation(fields: [pagoProveedorId], references: [id], onDelete: Cascade)

  facturaProveedorId String           @map("factura_proveedor_id")
  factura            FacturaProveedor @relation(fields: [facturaProveedorId], references: [id], onDelete: Restrict)

  montoImputado Decimal @map("monto_imputado") @db.Decimal(14, 0)

  @@unique([pagoProveedorId, facturaProveedorId])
  @@index([facturaProveedorId])
  @@map("imputacion_pago")
}

// ---------------------------------------------------------------------------
// §3.4 Clientes (cuenta corriente / fiado)
// ---------------------------------------------------------------------------

enum TipoMovimientoCuentaCorriente {
  cargo
  pago
}

enum ReferenciaCuentaCorriente {
  manual
  pago
  ajuste
  /// Reservado. Sin uso hoy: el sistema no registra ventas (§2.4).
  /// Deja la puerta abierta a un POS futuro sin costo.
  venta
}

model Cliente {
  id       String  @id @default(cuid())
  nombre   String
  telefono String?

  /// §8.3 resuelto: NO hay límite de crédito. El campo se eliminó en vez de
  /// dejarlo sin uso; si algún día hace falta, se agrega con la decisión tomada.

  /// Positivo = debe.
  saldo  Decimal @default(0) @db.Decimal(14, 0)
  activo Boolean @default(true)

  movimientos MovimientoCuentaCorriente[]

  @@index([nombre])
  @@index([activo])
  @@map("cliente")
}

model MovimientoCuentaCorriente {
  id String @id @default(cuid())

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  fecha DateTime                      @default(now())
  tipo  TipoMovimientoCuentaCorriente
  monto Decimal                       @db.Decimal(14, 0)

  /// Snapshot del saldo del cliente después de aplicar este movimiento. Permite
  /// reconstruir el estado de cuenta a cualquier fecha sin recalcular la historia (§3.4).
  saldoResultante Decimal @map("saldo_resultante") @db.Decimal(14, 0)

  referenciaTipo ReferenciaCuentaCorriente @default(manual) @map("referencia_tipo")
  referenciaId   String?                   @map("referencia_id")

  observacion String?

  /// Quién lo cargó. Null = movimiento anterior a los usuarios (ver cabecera).
  usuarioId String?  @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([clienteId, fecha])
  @@index([usuarioId])
  @@map("movimiento_cuenta_corriente")
}

// ---------------------------------------------------------------------------
// §9 Usuarios y permisos
//
// No estaba en la especificación original: se agrega porque el local pasa a
// trabajar con varias personas y el dueño quiere decidir quién puede cargar,
// quién puede anular y quién no entra a una sección.
//
// Reglas que atraviesan esta sección:
//   - Los usuarios NO se borran, se desactivan. Un usuario borrado dejaría
//     movimientos sin autor y rompería justamente lo que esto viene a dar.
//   - Los permisos se guardan como filas concedidas: lo que no está, no se puede.
//     Un permiso que se saca del código deja de existir sin migrar nada.
//   - El rol es solo la plantilla que marca los checkboxes al crear el usuario.
//     Después de eso manda la lista de permisos, no el rol.
// ---------------------------------------------------------------------------

/// Plantilla de permisos que se aplica al crear el usuario. NO se consulta para
/// autorizar: quien decide siempre es `permiso_usuario`. Se guarda para poder
/// mostrar "es un empleado" en la pantalla y para reaplicar la plantilla.
enum RolUsuario {
  dueno
  admin
  empleado
}

model Usuario {
  id String @id @default(cuid())

  /// Cómo se lo llama en pantalla: "Marcela Gómez".
  nombre  String
  /// Con qué entra: "marcela". Sin espacios, en minúsculas.
  usuario String @unique

  /// scrypt, en el formato que arma `src/lib/contrasena.ts`. Nunca la contraseña.
  hashContrasena String @map("hash_contrasena")

  rol RolUsuario

  /// Los usuarios no se borran (ver cabecera). Uno inactivo no puede entrar y sus
  /// movimientos siguen mostrando su nombre.
  activo Boolean @default(true)

  /// Lo prende el admin al restablecer una contraseña: la persona entra con la
  /// provisoria y el sistema la obliga a elegir una propia antes de seguir. Sin
  /// esto, la contraseña que tipeó el admin queda vigente para siempre y el admin
  /// conoce la clave de todos.
  debeCambiarContrasena Boolean @default(false) @map("debe_cambiar_contrasena")

  creadoEn DateTime @default(now()) @map("creado_en")

  permisos PermisoUsuario[]
  sesiones SesionUsuario[]

  turnos                     Turno[]
  movimientosCaja            MovimientoCaja[]
  movimientosCuentaCorriente MovimientoCuentaCorriente[]

  @@index([activo])
  @@map("usuario")
}

/// Un permiso concedido. La clave ("caja.anular") vive en el código, en
/// `src/domain/usuarios/permisos.ts`, y no en una tabla: las secciones del sistema
/// las define el código, no el dueño. Solo se guarda lo concedido.
model PermisoUsuario {
  id String @id @default(cuid())

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  permiso String

  @@unique([usuarioId, permiso])
  @@map("permiso_usuario")
}

/// Sesión abierta. Se guarda en la base y no en un token firmado a propósito: así
/// destildar un permiso tiene efecto en el próximo click, y no recién cuando la
/// persona vuelva a entrar. También permite cerrarle la sesión a alguien desde la
/// pantalla de usuarios.
///
/// §9: por decisión del dueño la sesión NO expira sola. Dura hasta que alguien
/// toca "Salir" o hasta que un admin la cierra.
model SesionUsuario {
  id String @id @default(cuid())

  /// SHA-256 del token que viaja en la cookie, nunca el token. Una copia de la
  /// base —un backup, la PC prestada al técnico— no alcanza para entrar como otro.
  hashToken String @unique @map("hash_token")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  creadaEn     DateTime @default(now()) @map("creada_en")
  /// Para poder mostrar "última actividad" en la lista de sesiones abiertas.
  ultimoAcceso DateTime @default(now()) @map("ultimo_acceso")

  @@index([usuarioId])
  @@map("sesion_usuario")
}
